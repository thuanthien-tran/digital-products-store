# Database
DATABASE_URL="file:./dev.db"

# SePay Webhook (get from sepay.vn)
SEPAY_WEBHOOK_KEY="your_sepay_webhook_key_here"

# Bank account info for VietQR generation
BANK_ACCOUNT_NUMBER="0123456789"
BANK_NAME="MB"  # MB, VCB, TCB, ACB, etc.
BANK_ACCOUNT_NAME="NGUYEN VAN A"

# Admin credentials (change these!)
ADMIN_USERNAME="thunthin"
ADMIN_PASSWORD="your_secure_password_here"

# JWT Secret for admin session (generate a random string)
JWT_SECRET="your_super_secret_jwt_key_change_this_in_production"

# Optional: Resend email
RESEND_API_KEY="re_your_resend_key"
FROM_EMAIL="noreply@yourdomain.com"

# Optional: Telegram bot notification
TELEGRAM_BOT_TOKEN="your_bot_token"
TELEGRAM_CHAT_ID="your_chat_id"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="ACCGIARE"
NEXT_PUBLIC_ZALO_PHONE_1="0356970964"
NEXT_PUBLIC_ZALO_PHONE_2="0356970964"

# FatCat Wholesale Provider API (Catalog sync & auto-fulfillment)
# API documentation: https://api.fatcatstore.click/
FATCAT_API_BASE_URL="https://api.fatcatstore.click"
FATCAT_API_KEY="your_fatcat_api_key_here"
ENABLE_FATCAT_INTEGRATION="true"
ENABLE_FATCAT_LIVE_BUY="false"

